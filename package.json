{
  "name": "qiaomu-blog-opensource",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "opennextjs-cloudflare build",
    "test": "vitest",
    "typecheck": "tsc --noEmit",
    "test:run": "vitest run",
    "verify": "bash scripts/verify.sh full",
    "verify:quick": "bash scripts/verify.sh quick",
    "preview": "pnpm preview:local",
    "preview:local": "bash scripts/cf-preview.sh --local",
    "preview:prod": "bash scripts/cf-preview.sh --prod",
    "cf:local:init": "bash scripts/cf-local-init.sh",
    "db:local:init": "pnpm cf:local:init",
    "deploy": "bash scripts/cf-deploy.sh",
    "worktree:add": "bash scripts/worktree-add.sh",
    "worktree:prune": "git worktree prune",
    "cf:types": "bash scripts/cf-typegen.sh",
    "cf-typegen": "pnpm cf:types",
    "cf:init": "bash scripts/cf-init.sh",
    "start": "next start",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "check": "biome check .",
    "check:write": "biome check --write ."
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "^2.0.47",
    "@ai-sdk/react": "^3.0.179",
    "@antv/infographic": "^0.2.19",
    "@opennextjs/cloudflare": "^1.19.1",
    "@tiptap/core": "^3.22.3",
    "@tiptap/extension-code-block-lowlight": "^3.22.5",
    "@tiptap/extension-image": "^3.22.3",
    "@tiptap/extension-table": "^3.22.3",
    "@tiptap/extension-table-cell": "^3.22.3",
    "@tiptap/extension-table-header": "^3.22.3",
    "@tiptap/extension-table-row": "^3.22.3",
    "@tiptap/extension-youtube": "^3.22.3",
    "@tiptap/pm": "^3.22.3",
    "@tiptap/react": "^3.22.3",
    "@tiptap/starter-kit": "^3.22.3",
    "@types/turndown": "^5.0.6",
    "ai": "^6.0.177",
    "fflate": "^0.8.2",
    "gray-matter": "^4.0.3",
    "highlight.js": "^11.11.1",
    "html2pdf.js": "^0.14.0",
    "juice": "^11.1.1",
    "katex": "^0.16.45",
    "konva": "^10.3.0",
    "linkedom": "^0.18.15",
    "linkifyjs": "^4.3.2",
    "lowlight": "^3.3.0",
    "lucide-react": "^1.8.0",
    "markdown-it": "^14.1.1",
    "mathjax-full": "^3.2.1",
    "mermaid": "^11.14.0",
    "nanoid": "^5.1.7",
    "next": "16.2.3",
    "novel": "^1.0.2",
    "openai": "^6.34.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-easy-crop": "^5.5.7",
    "react-konva": "^19.2.3",
    "remark": "^15.0.1",
    "remark-gfm": "^4.0.1",
    "remark-html": "^16.0.1",
    "tiptap-extension-auto-joiner": "^0.1.3",
    "tiptap-extension-global-drag-handle": "^0.1.18",
    "tiptap-markdown": "^0.9.0",
    "turndown": "^7.2.4"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.8",
    "@tailwindcss/postcss": "^4",
    "@types/better-sqlite3": "^7.6.13",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.10",
    "esbuild": "^0.28.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.5",
    "wrangler": "^4.84.1"
  },
  "description": "Open-source Cloudflare blog starter with Next.js 16, D1, R2, built-in themes, and AI provider presets.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rx-ted/blog.git"
  },
  "homepage": "https://github.com/rx-ted/blog",
  "bugs": {
    "url": "https://github.com/rx-ted/blog/issues"
  },
  "cloudflare": {
    "bindings": {
      "NEXT_PUBLIC_SITE_URL": {
        "description": "你的博客公网域名，例如 `https://blog.example.com`。"
      },
      "ADMIN_PASSWORD": {
        "description": "后台 `/dashboard` 登录密码。请使用高强度独立密码。"
      },
      "ADMIN_TOKEN_SALT": {
        "description": "管理员 Token 签名盐。可用 `openssl rand -hex 32` 生成。"
      },
      "AI_CONFIG_ENCRYPTION_SECRET": {
        "description": "用于加密保存 AI 供应商 Key。可用 `openssl rand -hex 32` 生成。"
      },
      "AI_API_KEY": {
        "description": "可选。外部 AI 服务的 API Key，用于文本生成或生图能力。"
      }
    }
  }
}
